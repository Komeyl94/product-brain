{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/engine/guardrail.mjs\" hook",
            "timeout": 20,
            "statusMessage": "Checking guardrails..."
          }
        ]
      }
    ]
  }
}
