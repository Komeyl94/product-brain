.DS_Store

# Artifacts pb sync generates inside any hub (e.g. when running on examples/).
# In a real standalone hub these are kept out of Git via .git/info/exclude instead.
**/repos/
**/graph/

# Python bytecode
__pycache__/
*.pyc

# Generated skill bundle (built on demand by bin/package-skill.sh)
dist/

# Per-machine Claude settings (contains local paths — never commit). The shared,
# path-free .claude/settings.json IS committed.
.claude/settings.local.json
